*.pt
*.pth
*.ckpt
*.onnx
*.nii.gz
*.nii
*.zip
*.tar.gz
experiments/*
!experiments/.gitkeep
reports/*.png
reports/*.pdf
!reports/.gitkeep
!reports/*.json
!reports/*.md

# IDE and OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
